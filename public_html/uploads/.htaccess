# Yüklenen dosyalar hiçbir koşulda sunucu kodu olarak çalıştırılmaz
Options -Indexes -ExecCGI
<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh|shtml|htm|html|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
